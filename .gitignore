# Uploaded files and local temporary artifacts are excluded from Git, with directory guards and placeholders retained.
assets/uploads/*
!assets/uploads/.gitkeep
*.log
Thumbs.db
.DS_Store
!assets/uploads/.htaccess

# Uploaded club images are excluded, with the placeholder and directory guard retained.
assets/images/clubs/*
!assets/images/clubs/.gitkeep
!assets/images/clubs/.htaccess

# Synthetic demonstration receipt images are retained in Git.
!assets/uploads/receipts/
assets/uploads/receipts/*
!assets/uploads/receipts/demo-receipt.png
!assets/uploads/membership-receipts/
assets/uploads/membership-receipts/*
!assets/uploads/membership-receipts/demo-receipt.png